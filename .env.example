# GitHub API Token (必需)
# 申请地址: https://github.com/settings/tokens
# 选择 "Generate new token (classic)"，勾选 "repo" 权限
GITHUB_TOKEN=your_github_token_here

# Jina AI API Key (可选，用于 Twitter 数据收集的高级功能)
# 申请地址: https://jina.ai/reader/#apikey
JINA_API_KEY=your_jina_api_key_here

# 数据收集天数（默认：7）
COLLECTION_DAYS=7

# 调试模式（可选）
DEBUG=false

# 日志级别（可选：DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO
