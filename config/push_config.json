{
  "push_policy": {
    "breaking": {
      "interval": "immediate",
      "max_per_day": 10,
      "quiet_hours": ["00:00-07:00"],
      "enabled": true
    },
    "important": {
      "interval": "1h",
      "batch_size": 5,
      "enabled": true,
      "schedule": ["00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "09:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00", "17:00", "18:00", "19:00", "20:00", "21:00", "22:00", "23:00"]
    },
    "normal": {
      "interval": "3h",
      "schedule": ["09:00", "12:00", "15:00", "18:00", "21:00"],
      "batch_size": 10,
      "enabled": true
    },
    "ignore": {
      "enabled": true
    }
  },

  "scoring_weights": {
    "release_type": 4,
    "notable_author": 3,
    "breaking_keyword": 3,
    "cross_company_consensus": 4,
    "engagement_surge": 2,
    "pr_merged": 2,
    "monitored_repo": 2,
    "tech_keyword": 1,
    "issue_discussion": 1,
    "comment_activity": 1
  },

  "thresholds": {
    "breaking": 5,
    "important": 2,
    "normal": 1
  },

  "keywords": {
    "breaking": [
      "breaking", "launch", "announce", "CVE", "critical",
      "zero-day", "vulnerability", "security", "exploit",
      "critical update", "major release", "breaking change",
      "gpt", "agi", "breakthrough", "revolutionary"
    ],
    "important": [
      "update", "improvement", "feature", "benchmark", "paper",
      "research", "optimization", "enhancement", "performance",
      "architecture", "implementation"
    ],
    "tech": [
      "transformer", "attention", "diffusion", "llama", "whisper",
      "codex", "dalle", "multimodal", "embedding", "rag",
      "finetuning", "rlhf", "agents", "reasoning", "alignment",
      "scaling", "mixture-of-experts", "retrieval", "quantization",
      "optimization", "prompt engineering", "few-shot", "zero-shot",
      "chain-of-thought", "tool use", "autonomous", "web agents"
    ]
  },

  "monitored_repos": [
    "openai/*",
    "deepmind/*",
    "anthropic/*",
    "google-research/*",
    "facebookresearch/*",
    "huggingface/*"
  ],

  "notable_authors": [
    "sama", "ilyasut", "gdb",
    "demishassabis", "mustafasuleyman",
    "karpathy", "lecun", "jeffdean",
    "andrewyng", "goodfellow"
  ],

  "engagement_thresholds": {
    "surge_percentage": 300,
    "high_engagement": 100,
    "low_engagement": 10
  },

  "duplicate_detection": {
    "similarity_threshold": 0.8,
    "time_window_hours": 24
  }
}
